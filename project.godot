; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Planet Drop"
config/description="Drop planets, merge them into bigger ones, and grow your way to the Sun."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.050980393, 0.043137256, 0.13333334, 1)
boot_splash/show_image=false
config/icon="res://assets/ui/icon.png"

[autoload]

Save="*res://scripts/autoload/save_data.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=1500.0
2d/solver/solver_iterations=24
2d/sleep_threshold_linear=4.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.050980393, 0.043137256, 0.13333334, 1)
textures/vram_compression/import_etc2_astc=true
